APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Keep CI and local test output aligned with the Japan-focused earthquake map UI.
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Use the same Laravel disk name for local MinIO and production AWS S3.
# Provider differences should be handled by endpoint/credential env values,
# not by branching application code.
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage settings.
# Local MinIO example:
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio_password
# AWS_DEFAULT_REGION=ap-northeast-1
# AWS_BUCKET=local-bucket
# AWS_ENDPOINT=http://minio:9000
# AWS_URL=http://localhost:9000/local-bucket
# AWS_USE_PATH_STYLE_ENDPOINT=true
#
# For production AWS S3, set real values only in the deployed .env or secret
# store. Do not commit production AWS keys or bucket-specific secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
# MinIO needs an internal Docker endpoint for Laravel containers.
# Leave empty for normal AWS S3 unless a custom S3-compatible endpoint is used.
AWS_ENDPOINT=
# Optional public URL used when generating file URLs.
# For local MinIO this points to the host-bound localhost URL.
AWS_URL=
# Required for MinIO because buckets are addressed as /bucket/key.
# AWS S3 can also use the default provider behavior when this is overridden.
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
